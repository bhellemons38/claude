# ─────────────────────────────────────────────────────────
# Nacholito B2B Bestelportaal — Environment Variables
# Copy this file to .env.local and fill in your values.
# ─────────────────────────────────────────────────────────

# Base URL of your deployment (no trailing slash)
# Development: http://localhost:3000
# Production:  https://bestellen.nacholito.nl
BASE_URL=http://localhost:3000

# ── Mollie ───────────────────────────────────────────────
# Get your API key from: https://my.mollie.com/dashboard/developers/api-keys
# Use test_... prefix for development, live_... for production
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Exact Online ─────────────────────────────────────────
# Register an app at: https://apps.exactonline.com/
# OAuth2 client credentials flow (for server-to-server)
EXACT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
EXACT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Exact Online division number
# Find it in: Exact Online → Settings → Company → About
# Or from the URL: /api/v1/{division}/...
EXACT_DIVISION=123456

# ── Resend ───────────────────────────────────────────────
# Get your API key from: https://resend.com/api-keys
# Add and verify your sending domain in the Resend dashboard
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
